{
  "name": "perf-observer-js",
  "version": "2.2.4",
  "description": "Network performance monitoring for web apps. Service Worker timing plus response headers.",
  "main": "dist/PerformanceMonitor.js",
  "types": "dist/PerformanceMonitor.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --silent",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "performance",
    "monitoring",
    "service-worker",
    "metrics",
    "web-performance",
    "network-monitoring",
    "resource-timing",
    "response-headers",
    "typescript"
  ],
  "author": "Nithin Murali <nithintecharch@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nithin-murali-arch/perf-observer-js"
  },
  "bugs": {
    "url": "https://github.com/nithin-murali-arch/perf-observer-js/issues"
  },
  "homepage": "https://github.com/nithin-murali-arch/perf-observer-js#readme",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/serviceworker": "^0.0.133",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironmentOptions": {
      "url": "http://localhost"
    }
  }
}
